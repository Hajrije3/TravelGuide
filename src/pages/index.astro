---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../site.config';
import { CATEGORIES } from '../lib/categories';
import { getArticles } from '../lib/articles';
import SampleCard from '../components/SampleCard.astro';
import { SAMPLES } from '../lib/samples';

const articles = await getArticles();
const latest = articles.slice(0, 6);

const promises = [
  { title: 'Date-stamped costs', text: 'Every budget shows when prices were checked and what is included.' },
  { title: 'Realistic timing', text: 'Itineraries with actual transport details, not wishful schedules.' },
  { title: 'Where to stay, explained', text: 'Area comparisons that tell you who each neighborhood suits.' },
  { title: 'Tools that save time', text: 'Checklists, planners and budget sheets you can download and use.' },
];
---
<BaseLayout jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, description: SITE.positioning }}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Affordable European travel</p>
      <h1>Explore more of Europe.<br />Spend less doing it.</h1>
      <p class="lead">{SITE.positioning}</p>
      <div class="actions">
        <a class="btn" href="/plan-my-trip/">Plan my trip for me</a>
        <a class="btn btn-ghost" href="/category/itineraries/">Browse itineraries</a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="cat-title">
    <div class="section-head"><h2 id="cat-title">Plan your trip</h2></div>
    <ul class="cats">
      {Object.entries(CATEGORIES).map(([key, c]) => (
        <li><a href={`/category/${key}/`}><strong>{c.title}</strong><span>{c.description}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">Latest guides</h2>
    </div>
    {latest.length
      ? <div class="grid">{latest.map((a) => <ArticleCard article={a} />)}</div>
      : <p class="empty">The first guides are being researched and written. Check back soon.</p>}
  </section>

  <section class="section container" aria-labelledby="samples-title">
    <div class="section-head">
      <h2 id="samples-title">Sample travel plans</h2>
      <a href="/sample-plans/">See all samples</a>
    </div>
    <p class="lead samples-lead">See what a personalised plan looks like, then <a href="/plan-my-trip/">request your own</a>.</p>
    <div class="grid">{SAMPLES.slice(0, 3).map((s) => <SampleCard sample={s} />)}</div>
  </section>

  <section class="section promise-wrap">
    <div class="container">
      <div class="section-head"><h2>What you can expect from every guide</h2></div>
      <ul class="promises">
        {promises.map((p) => <li><strong>{p.title}</strong><span>{p.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section container planner" aria-labelledby="planner-title">
    <div>
      <p class="eyebrow">Coming soon</p>
      <h2 id="planner-title">European Weekend Travel Planner</h2>
      <p class="lead">A three-day itinerary planner, budget calculator, accommodation comparison sheet and packing checklist, all in one download.</p>
      <a class="btn btn-ghost" href="/planner/">Find out more</a>
    </div>
  </section>

  <section class="container"><Newsletter /></section>
</BaseLayout>

<style>
  .hero { padding: clamp(48px, 9vw, 104px) 0 clamp(40px, 6vw, 72px); background: radial-gradient(ellipse at 85% 0%, var(--accent-soft), transparent 60%), radial-gradient(ellipse at 0% 100%, var(--sea-soft), transparent 55%); }
  .hero h1 { font-size: clamp(2.3rem, 6vw, 4rem); max-width: 16ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .cats { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .cats a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 18px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); }
  .cats a:hover { border-color: var(--accent); }
  .cats strong { font-family: var(--font-serif); font-size: 1.1rem; }
  .cats span { color: var(--ink-soft); font-size: .92rem; }

  .samples-lead { margin: -8px 0 24px; }
  .promise-wrap { background: var(--card); border-block: 1px solid var(--line); }
  .promises { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .promises li { display: flex; flex-direction: column; gap: 4px; padding-left: 16px; border-left: 3px solid var(--accent); }
  .promises span { color: var(--ink-soft); }

  .planner > div { background: var(--accent-soft); border-radius: calc(var(--radius) * 1.5); padding: clamp(24px, 5vw, 48px); }
  .planner h2 { margin-top: 0; }
</style>
