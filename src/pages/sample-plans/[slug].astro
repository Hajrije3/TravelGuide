---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SampleCard from '../../components/SampleCard.astro';
import { SAMPLES, mapsUrl, type SamplePlan } from '../../lib/samples';
import { SITE } from '../../site.config';

export function getStaticPaths() {
  return SAMPLES.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}

const { sample: s } = Astro.props as { sample: SamplePlan };
const tp = SITE.tripPlanning;
const pkg = tp.packages.find((p) => s.days <= p.maxDays) ?? tp.packages[tp.packages.length - 1];
const requestUrl = `/plan-my-trip/?destination=${encodeURIComponent(s.city)}&days=${s.days}`;
const others = SAMPLES.filter((x) => x.slug !== s.slug).slice(0, 3);
const day1Pins = s.day1.activities.flatMap((a) => a.places);
---
<BaseLayout title={`Sample plan: ${s.days} days in ${s.city}`} description={`${s.overview.slice(0, 150)}…`} image={s.cover}>
  <!-- Cover -->
  <header class="cover">
    <img src={s.cover} alt={s.coverAlt} width="1600" height="900" fetchpriority="high" />
    <div class="cover-text container">
      <p class="tag">Sample plan {s.number}</p>
      <h1>{s.city}, {s.country}</h1>
      <p class="sub">{s.days} days · {s.theme}</p>
    </div>
  </header>
  <p class="container credit">Photo: <a href={s.credit.source} rel="nofollow">{s.credit.author}</a>, <a href={s.credit.licenseUrl} rel="license nofollow">{s.credit.license}</a>, via Wikimedia Commons</p>

  <div class="container layout">
    <div class="main">
      <!-- Overview -->
      <section class="block">
        <div class="prepared">
          <p class="label">Prepared for <span class="badge">Fictional traveler</span></p>
          <dl>
            <div><dt>Traveler</dt><dd>{s.traveler.name}</dd></div>
            <div><dt>From</dt><dd>{s.traveler.from}</dd></div>
            <div><dt>Group</dt><dd>{s.traveler.group}</dd></div>
            <div><dt>Budget</dt><dd>{s.traveler.budget}</dd></div>
            <div><dt>Style</dt><dd>{s.traveler.style}</dd></div>
            <div><dt>Notes</dt><dd>{s.traveler.notes}</dd></div>
          </dl>
        </div>
        <h2>Trip overview</h2>
        <p>{s.overview}</p>
        <ul class="chips">{s.highlights.map((h) => <li>{h}</li>)}</ul>
      </section>

      <!-- Budget -->
      <section class="block">
        <h2>Estimated budget</h2>
        <table class="budget">
          <tbody>
            {s.budget.map((b) => <tr><td>{b.item}</td><td>{b.amount}</td></tr>)}
            <tr class="total"><td>Total for the trip</td><td>{s.budgetTotal}</td></tr>
          </tbody>
        </table>
        <p class="fine">Estimates excluding flights. Prices change; your plan uses prices checked at the time we write it.</p>
      </section>

      <!-- Day 1 (open) -->
      <section class="block">
        <h2>Day 1 · {s.day1.title}</h2>
        <ol class="timeline">
          {s.day1.activities.map((a) => (
            <li>
              <p class="time">{a.time}</p>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <p class="pins">
                {a.places.map((p) => (
                  <a href={mapsUrl(p)} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" /></svg>
                    {p.split(',')[0]}
                  </a>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Locked days: real content is intentionally not on the page -->
      {s.lockedDays.map((d) => (
        <section class="block locked-day">
          <h2>{d}</h2>
          <div class="locked" aria-hidden="true">
            <div class="skel"><span></span><span></span><span></span><span class="short"></span><span></span><span class="short"></span></div>
          </div>
          <p class="lock-msg">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 9V7A5 5 0 0 0 7 7v2H5v13h14V9h-2zM9 7a3 3 0 0 1 6 0v2H9V7zm4 10.7V19h-2v-1.3a2 2 0 1 1 2 0z" /></svg>
            Morning, afternoon and evening plan included in the full plan
          </p>
        </section>
      ))}

      <!-- Teasers -->
      <section class="block">
        <h2>Also in the full plan</h2>
        <div class="tiles">
          <div class="tile">
            <h3>Restaurants & food</h3>
            <p><strong>{s.food.name}</strong>: {s.food.text}</p>
            <p class="locked-line">🔒 +{s.food.more} more places to eat</p>
          </div>
          <div class="tile">
            <h3>Where to stay</h3>
            <p><strong>{s.stay.area}</strong>: {s.stay.text}</p>
            <p class="locked-line">🔒 +{s.stay.more} more areas compared, with price ranges</p>
          </div>
          <div class="tile">
            <h3>Transport</h3>
            <p>{s.transport}</p>
            <p class="locked-line">🔒 Step-by-step directions for every day</p>
          </div>
          <div class="tile">
            <h3>Google Maps links</h3>
            <p>{day1Pins.length} places from Day 1 are linked above.</p>
            <p class="locked-line">🔒 +{s.mapsPins - day1Pins.length} more places pinned</p>
          </div>
          <div class="tile">
            <h3>Travel tips</h3>
            <p>{s.tip.text}</p>
            <p class="locked-line">🔒 +{s.tip.more} more local tips</p>
          </div>
        </div>
      </section>
    </div>

    <aside class="side">
      <div class="cta-card">
        <p class="eyebrow">Want a plan like this?</p>
        <h2>Get your own {s.city} plan</h2>
        <p>Built around your dates, budget and departure city, with every day fully planned.</p>
        <p class="price"><span>{pkg.name}</span><strong>{tp.currency}{pkg.price}</strong></p>
        <a class="btn" href={requestUrl}>Request my plan</a>
        <p class="fine">Delivered by email within {tp.deliveryTime}.</p>
      </div>
    </aside>
  </div>

  <section class="section container">
    <div class="section-head"><h2>More sample plans</h2><a href="/sample-plans/">See all</a></div>
    <div class="grid">{others.map((o) => <SampleCard sample={o} />)}</div>
  </section>
</BaseLayout>

<style>
  .cover { position: relative; color: #fff; }
  .cover img { width: 100%; height: clamp(320px, 55vh, 560px); object-fit: cover; }
  .cover::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(15 23 32 / .8), rgb(15 23 32 / .1) 60%); }
  .cover-text { position: absolute; left: 0; right: 0; bottom: 28px; z-index: 1; }
  .tag { display: inline-block; background: var(--accent); padding: 4px 12px; border-radius: 999px; font-weight: 700; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; margin: 0 0 12px; }
  .cover h1 { color: #fff; margin: 0; font-size: clamp(2.2rem, 6vw, 3.8rem); }
  .sub { font-size: 1.2rem; margin: 6px 0 0; opacity: .95; }
  .credit { font-size: .8rem; color: var(--muted); text-align: right; margin-top: 8px; }
  .credit a { color: inherit; }

  .layout { display: grid; gap: 32px; margin-top: 24px; }
  @media (min-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr) 320px; } .side { position: relative; } .cta-card { position: sticky; top: 88px; } }
  .block { padding: 28px 0; border-bottom: 1px solid var(--line); }
  .block h2 { margin: 0 0 14px; }

  .prepared { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 24px; }
  .label { font-weight: 700; margin: 0 0 10px; display: flex; gap: 8px; align-items: center; }
  dl { margin: 0; display: grid; gap: 10px 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); }
  dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  dd { margin: 0; font-weight: 600; }
  .chips { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { background: var(--sea-soft); color: var(--sea); padding: 6px 12px; border-radius: 999px; font-weight: 600; font-size: .9rem; }

  .budget { width: 100%; border-collapse: collapse; background: var(--card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .budget td { padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .budget td:last-child { text-align: right; white-space: nowrap; font-weight: 600; }
  .budget .total td { background: var(--ink); color: #fff; font-weight: 700; border: 0; }
  .fine { font-size: .85rem; color: var(--muted); margin-top: 10px; }

  .timeline { list-style: none; padding: 0; margin: 0; }
  .timeline li { position: relative; padding: 0 0 24px 28px; border-left: 2px solid var(--accent-soft); margin-left: 8px; }
  .timeline li::before { content: ''; position: absolute; left: -9px; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: var(--accent); border: 3px solid var(--paper); }
  .timeline li:last-child { padding-bottom: 0; }
  .time { margin: 0; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--accent-ink); }
  .timeline h3 { margin: 2px 0 6px; font-size: 1.15rem; }
  .timeline p { margin: 0 0 8px; }
  .pins { display: flex; flex-wrap: wrap; gap: 8px; }
  .pins a { display: inline-flex; align-items: center; gap: 4px; font-size: .88rem; font-weight: 600; text-decoration: none; background: var(--card); border: 1px solid var(--line); padding: 4px 10px 4px 6px; border-radius: 999px; }
  .pins svg { width: 16px; height: 16px; fill: #d93025; }

  .locked { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--card); border: 1px solid var(--line); padding: 20px; }
  .skel { display: grid; gap: 12px; filter: blur(3px); }
  .skel span { height: 12px; border-radius: 6px; background: linear-gradient(90deg, #e6e2da, #efece6); }
  .skel .short { width: 60%; }
  .lock-msg { display: flex; align-items: center; gap: 8px; margin: 12px 0 0; font-weight: 600; color: var(--ink-soft); }
  .lock-msg svg { width: 18px; height: 18px; fill: var(--accent); flex: none; }

  .tiles { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; }
  .tile h3 { margin: 0 0 8px; font-size: 1.05rem; }
  .tile p { margin: 0 0 8px; font-size: .95rem; color: var(--ink-soft); }
  .locked-line { color: var(--accent-ink) !important; font-weight: 600; margin: 0 !important; }

  .cta-card { background: var(--accent-soft); border-radius: calc(var(--radius) * 1.5); padding: 24px; }
  .cta-card h2 { margin: 0 0 8px; font-size: 1.5rem; }
  .cta-card .price { display: flex; justify-content: space-between; align-items: baseline; margin: 16px 0; }
  .cta-card .price strong { font: 700 1.8rem var(--font-serif); color: var(--accent-ink); }
  .cta-card .btn { display: block; text-align: center; }
</style>
