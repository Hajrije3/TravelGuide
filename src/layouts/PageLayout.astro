---
import BaseLayout from './BaseLayout.astro';

interface Props { title: string; description?: string; eyebrow?: string; noindex?: boolean }
const { title, description, eyebrow, noindex } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="section container prose-width">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="lead">{description}</p>}
    <div class="prose"><slot /></div>
  </div>
  <slot name="after" />
</BaseLayout>
